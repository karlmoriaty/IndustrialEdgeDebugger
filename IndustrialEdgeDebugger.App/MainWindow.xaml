<Window x:Class="IndustrialEdgeDebugger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IndustrialEdgeDebugger.App"
        xmlns:vm="clr-namespace:IndustrialEdgeDebugger.App.ViewModels"
        xmlns:ctrl="clr-namespace:IndustrialEdgeDebugger.App.Controls"
        mc:Ignorable="d"
        Title="IndustrialEdge Debugger" Height="800" Width="1200">
    <Window.Resources>
        <vm:MainWindowViewModel x:Key="ViewModel"/>
    </Window.Resources>
    <Grid DataContext="{StaticResource ViewModel}" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="设备配置" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="设备类型:" VerticalAlignment="Center" Margin="0,5"/>
                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding DeviceTypes}" SelectedItem="{Binding SelectedDeviceType}" Margin="5,5,10,5">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Row="0" Grid.Column="2" Content="刷新设备" Command="{Binding RefreshDevicesCommand}" Width="80" Margin="0,5"/>

                <TextBlock Grid.Row="0" Grid.Column="3" Text="设备:" VerticalAlignment="Center" Margin="10,5,0,5"/>
                <ComboBox Grid.Row="0" Grid.Column="4" ItemsSource="{Binding AvailableDevices}" SelectedItem="{Binding SelectedDevice}" Margin="5,5" Grid.ColumnSpan="2">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                <TextBlock Text=" (" Margin="5,0,0,0"/>
                                <TextBlock Text="{Binding Description}"/>
                                <TextBlock Text=")"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="波特率:" VerticalAlignment="Center" Margin="0,5"/>
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding BaudRates}" SelectedItem="{Binding SelectedBaudRate}" Margin="5,5,10,5"/>

                <TextBlock Grid.Row="1" Grid.Column="3" Text="数据位:" VerticalAlignment="Center" Margin="10,5,0,5"/>
                <ComboBox Grid.Row="1" Grid.Column="4" ItemsSource="{Binding DataBitsOptions}" SelectedItem="{Binding SelectedDataBits}" Margin="5,5"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="停止位:" VerticalAlignment="Center" Margin="0,5"/>
                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding StopBitsOptions}" SelectedItem="{Binding SelectedStopBits}" Margin="5,5,10,5"/>

                <TextBlock Grid.Row="2" Grid.Column="3" Text="校验位:" VerticalAlignment="Center" Margin="10,5,0,5"/>
                <ComboBox Grid.Row="2" Grid.Column="4" ItemsSource="{Binding Parities}" SelectedItem="{Binding SelectedParity}" Margin="5,5"/>

                <StackPanel Grid.Row="1" Grid.Column="5" Grid.RowSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="连接" Command="{Binding ConnectCommand}" Width="80" Margin="0,5,10,5"/>
                    <Button Content="断开" Command="{Binding DisconnectCommand}" Width="80" Margin="0,5,10,5"/>
                    <Button Content="开始记录" Command="{Binding StartRecordingCommand}" Width="100" Margin="0,5,10,5"/>
                    <Button Content="停止记录" Command="{Binding StopRecordingCommand}" Width="100" Margin="0,5,10,5"/>
                    <Button Content="波形模拟" Command="{Binding ToggleSimulationCommand}" Width="100" Margin="0,5,10,5"/>
                    <Button Content="清空波形" Command="{Binding ClearWaveformsCommand}" Width="100" Margin="0,5,10,5"/>
                    <Button x:Name="SettingsButton" Content="设置" Width="80" Margin="0,5"/>
                    <Button Content="日志查询" Name="LogQueryButton" Click="LogQueryButton_Click" Width="100" Margin="0,5"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="状态" Padding="10" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="连接状态:" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center" Margin="10,0" FontWeight="Bold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Red"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Foreground" Value="Green"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="波形模拟:" VerticalAlignment="Center" FontWeight="Bold" Margin="20,0,0,0"/>
                <TextBlock x:Name="SimulationStatusText" VerticalAlignment="Center" Margin="10,0" FontWeight="Bold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="关闭"/>
                            <Setter Property="Foreground" Value="Red"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSimulating}" Value="True">
                                    <Setter Property="Text" Value="运行中"/>
                                    <Setter Property="Foreground" Value="Green"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="数据记录:" VerticalAlignment="Center" FontWeight="Bold" Margin="20,0,0,0"/>
                <TextBlock Text="{Binding RecordingStatus}" VerticalAlignment="Center" Margin="10,0" FontWeight="Bold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Red"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                    <Setter Property="Foreground" Value="Green"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="数据点:" VerticalAlignment="Center" FontWeight="Bold" Margin="20,0,0,0"/>
                <TextBlock Text="{Binding DataPointCountText}" VerticalAlignment="Center" Margin="10,0" FontWeight="Bold" Foreground="Blue"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="实时波形" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ctrl:WaveformRenderer Grid.Column="0" Channels="{Binding WaveformChannels}"/>
                <Border Grid.Column="1" Width="150" Margin="10,0,0,0">
                    <GroupBox Header="通道">
                        <StackPanel>
                            <CheckBox Content="{Binding WaveformChannels[0].Name}" IsChecked="{Binding WaveformChannels[0].IsVisible}" Margin="5"/>
                            <CheckBox Content="{Binding WaveformChannels[1].Name}" IsChecked="{Binding WaveformChannels[1].IsVisible}" Margin="5"/>
                            <CheckBox Content="{Binding WaveformChannels[2].Name}" IsChecked="{Binding WaveformChannels[2].IsVisible}" Margin="5"/>
                            <TextBlock Text="提示:" Margin="5,10,5,0" FontWeight="Bold"/>
                            <TextBlock Text="• 滚轮缩放" Margin="10,2"/>
                            <TextBlock Text="• Ctrl+滚轮Y轴缩放" Margin="10,2"/>
                            <TextBlock Text="• 拖拽平移" Margin="10,2"/>
                        </StackPanel>
                    </GroupBox>
                </Border>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="接收数据" Padding="10" Margin="0,10,0,0" Height="150">
            <TextBox Text="{Binding ReceivedData, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" FontFamily="Consolas"/>
        </GroupBox>
    </Grid>
</Window>
