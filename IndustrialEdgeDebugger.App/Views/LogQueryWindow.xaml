<Window x:Class="IndustrialEdgeDebugger.App.Views.LogQueryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IndustrialEdgeDebugger.App.Views"
        mc:Ignorable="d"
        Title="日志查询" Height="700" Width="1200"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="查询条件" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="开始时间:" VerticalAlignment="Center" Margin="0,5,5,5"/>
                <DatePicker Grid.Row="0" Grid.Column="1" SelectedDate="{Binding StartTime}" VerticalAlignment="Center" Margin="0,5,10,5"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="结束时间:" VerticalAlignment="Center" Margin="0,5,5,5"/>
                <DatePicker Grid.Row="0" Grid.Column="3" SelectedDate="{Binding EndTime}" VerticalAlignment="Center" Margin="0,5,0,5"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="设备ID:" VerticalAlignment="Center" Margin="0,5,5,5"/>
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableDeviceIds}" SelectedItem="{Binding SelectedDeviceId}" IsEditable="True" VerticalAlignment="Center" Margin="0,5,10,5"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="数据类型:" VerticalAlignment="Center" Margin="0,5,5,5"/>
                <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding AvailableDataTypes}" SelectedItem="{Binding SelectedDataType}" IsEditable="True" VerticalAlignment="Center" Margin="0,5,0,5"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="关键词:" VerticalAlignment="Center" Margin="0,5,5,5"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Keyword}" VerticalAlignment="Center" Margin="0,5,10,5"/>

                <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="查询" Command="{Binding QueryCommand}" Width="80" Margin="5,5"/>
                    <Button Content="清空" Command="{Binding ClearCommand}" Width="80" Margin="5,5"/>
                    <Button Content="导出CSV" Command="{Binding ExportCommand}" Width="80" Margin="5,5"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="查询结果" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0" ItemsSource="{Binding Logs}" 
                          SelectedItem="{Binding SelectedLog}"
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          CanUserSortColumns="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          MouseDoubleClick="DataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                        <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss.fff'}" Width="180"/>
                        <DataGridTextColumn Header="设备ID" Binding="{Binding DeviceId}" Width="120"/>
                        <DataGridTextColumn Header="数据类型" Binding="{Binding DataType}" Width="120"/>
                        <DataGridTextColumn Header="数据" Binding="{Binding Data}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="上一页" Command="{Binding PreviousPageCommand}" Width="80" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding CurrentPage, StringFormat='第 {0} 页'}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding TotalPages, StringFormat='共 {0} 页'}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding TotalCount, StringFormat='共 {0} 条记录'}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="下一页" Command="{Binding NextPageCommand}" Width="80"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Name="StatusText">
                    <Run Text="状态: "/>
                    <Run Name="StatusValue" Text="就绪"/>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
