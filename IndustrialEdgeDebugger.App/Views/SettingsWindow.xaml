<Window x:Class="IndustrialEdgeDebugger.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="设置" Height="600" Width="500"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="串口设置" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="默认波特率:" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding BaudRate}" Margin="5,5" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="数据位:" VerticalAlignment="Center" Margin="0,5"/>
                <ComboBox Grid.Row="1" Grid.Column="1" SelectedItem="{Binding DataBits}" Margin="5,5">
                    <ComboBoxItem Content="5"/>
                    <ComboBoxItem Content="6"/>
                    <ComboBoxItem Content="7"/>
                    <ComboBoxItem Content="8"/>
                </ComboBox>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="停止位:" VerticalAlignment="Center" Margin="0,5"/>
                <ComboBox Grid.Row="2" Grid.Column="1" SelectedItem="{Binding StopBits}" Margin="5,5">
                    <ComboBoxItem Content="One"/>
                    <ComboBoxItem Content="OnePointFive"/>
                    <ComboBoxItem Content="Two"/>
                </ComboBox>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="校验位:" VerticalAlignment="Center" Margin="0,5"/>
                <ComboBox Grid.Row="3" Grid.Column="1" SelectedItem="{Binding Parity}" Margin="5,5">
                    <ComboBoxItem Content="None"/>
                    <ComboBoxItem Content="Odd"/>
                    <ComboBoxItem Content="Even"/>
                    <ComboBoxItem Content="Mark"/>
                    <ComboBoxItem Content="Space"/>
                </ComboBox>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="握手协议:" VerticalAlignment="Center" Margin="0,5"/>
                <ComboBox Grid.Row="4" Grid.Column="1" SelectedItem="{Binding Handshake}" Margin="5,5">
                    <ComboBoxItem Content="None"/>
                    <ComboBoxItem Content="XOnXOff"/>
                    <ComboBoxItem Content="RequestToSend"/>
                    <ComboBoxItem Content="RequestToSendXOnXOff"/>
                </ComboBox>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="波形设置" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="通道1颜色:" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Channel1Color}" Margin="5,5" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="通道2颜色:" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Channel2Color}" Margin="5,5" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="通道3颜色:" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Channel3Color}" Margin="5,5" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="缓冲区大小:" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding BufferSize}" Margin="5,5" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="默认X轴缩放:" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DefaultZoomX}" Margin="5,5" VerticalContentAlignment="Center"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="用户偏好" Padding="10" Margin="0,10,0,0">
            <StackPanel>
                <CheckBox Content="启动时自动连接串口" IsChecked="{Binding AutoConnectOnStartup}" Margin="5"/>
                <CheckBox Content="自动保存日志" IsChecked="{Binding SaveLogAutomatically}" Margin="5,10,5,0"/>
                <StackPanel Orientation="Horizontal" Margin="5,10,0,0">
                    <TextBlock Text="主题:" VerticalAlignment="Center"/>
                    <ComboBox SelectedItem="{Binding Theme}" Margin="10,0" Width="100">
                        <ComboBoxItem Content="Light"/>
                        <ComboBoxItem Content="Dark"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="重置默认" Command="{Binding ResetCommand}" Width="100" Margin="0,0,10,0"/>
            <Button Content="保存" Command="{Binding SaveCommand}" Width="100" Margin="0,0,10,0"/>
            <Button Content="取消" Command="{Binding CancelCommand}" Width="100"/>
        </StackPanel>
    </Grid>
</Window>
